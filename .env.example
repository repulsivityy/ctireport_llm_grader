# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Model Architecture (verify these IDs against the current Gemini model list before deploying)
PRIMARY_MODEL=gemini-3.5-flash-lite
META_MODEL=gemini-3.7-flash

# Google Cloud & Firestore Configuration
GOOGLE_CLOUD_PROJECT=<your-project-name-here>
FIRESTORE_COLLECTION=cti_submissions

# Instructor emails (comma-separated). Must match the Google account emails IAP sees.
INSTRUCTOR_EMAILS=instructor@your-domain.edu

# Who may pass through IAP (comma-separated IAM principals). Used by deploy.sh.
# e.g. "domain:your-domain.edu,group:cti-class@your-domain.edu"
ALLOWED_PRINCIPALS=

# Optional: harden IAP identity by verifying the signed JWT assertion instead of the
# plain header. Set to the Cloud Run IAP audience string once known.
IAP_JWT_AUDIENCE=

# Local development ONLY. When "true", identity is taken from a sidebar text box
# instead of IAP. Never set this in a deployed environment.
ALLOW_INSECURE_LOCAL_AUTH=true
